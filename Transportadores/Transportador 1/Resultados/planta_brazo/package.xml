<?xml version="1.0"?>
<!-- Manifiesto del paquete planta_brazo. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planta_brazo</name>
  <version>1.0.0</version>
  <description>
    Descripcion URDF y simulacion en RViz2 y en Gazebo (gz sim) del robot antropomorfico 3R
    "PLANTA BRAZO" del Laboratorio de Robotica (UMNG). Mallas tomadas del
    CAD de SolidWorks (carpeta STL) y cinematica directa segun
    CinematicaDirecta.pdf.
  </description>
  <maintainer email="est.julian.castaneda@unimilitar.edu.co">Julian Castaneda</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
