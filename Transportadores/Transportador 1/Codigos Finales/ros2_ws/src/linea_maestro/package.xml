<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>linea_maestro</name>
  <version>0.0.0</version>
  <description>Nodo maestro de la linea de empacado del Equipo 5 (transportador 1).
    Coordina 5 robots por los topics /&lt;robot&gt;/orden, /&lt;robot&gt;/estado, /parada y /linea/estado.</description>
  <maintainer email="est.julian.castaneda@unimilitar.edu.co">Equipo 5 - Planta Brazo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
