      <joint_name>J3</joint_name>
      <topic>/ensamblador2/J3/cmd_pos</topic>
      <p_gain>800.0</p_gain>
      <i_gain>100.0</i_gain>
      <d_gain>40.0</d_gain>
      <i_max>50.0</i_max>
