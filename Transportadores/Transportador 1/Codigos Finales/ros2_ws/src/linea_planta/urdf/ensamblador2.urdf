  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>J1</joint_name>
      <topic>/ensamblador2/J1/cmd_pos</topic>
      <p_gain>120.0</p_gain>
      <i_gain>40.0</i_gain>
      <d_gain>6.0</d_gain>
      <i_max>20.0</i_max>
      <i_min>-20.0</i_min>
