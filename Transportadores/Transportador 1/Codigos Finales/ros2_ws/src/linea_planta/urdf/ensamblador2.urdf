<?xml version='1.0' encoding='utf-8'?>
<robot name="ensamblador2">
  <!-- GENERADO por herramientas/preparar_urdf.py a partir de originales/ensamblador2_Ensamble.urdf. No editar a mano: editar el original o la herramienta y regenerar. -->
  <link name="world" />
  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.056032 0.0033807 0.021531" rpy="0 0 0" />
      <mass value="0.85079" />
      <inertia ixx="0.0019389" ixy="-9.299E-06" ixz="-1.6398E-05" iyy="0.0036565" iyz="2.4252E-06" izz="0.0050574" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.03235" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.0647" />
      </geometry>
      <material name="forma_base_link">
        <color rgba="0.55 0.55 0.58 1" />
      </material>
    </visual>
  </link>
  <link name="link_1">
    <inertial>
      <origin xyz="0.042088 0 0.017457" rpy="0 0 0" />
      <mass value="0.93496" />
      <inertia ixx="0.00079423" ixy="3.6586E-08" ixz="1.4041E-05" iyy="0.0013551" iyz="-5.3153E-08" izz="0.0019619" />
    </inertial>
    <visual>
      <origin xyz="0.1 0 0.017" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.05 0.034" />
      </geometry>
      <material name="forma_link_1">
        <color rgba="0.55 0.75 0.95 1" />
      </material>
    </visual>
  </link>
  <joint name="J1" type="continuous">
    <origin xyz="0 0 0.0647" rpy="0 0 -0.010482" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="0 0 1" />
    <limit effort="100.0" velocity="10.0" />
    <dynamics damping="1" friction="1" />
  </joint>
  <link name="link_2">
    <inertial>
      <origin xyz="0.070392 0 0.055205" rpy="0 0 0" />
      <mass value="0.69898" />
      <inertia ixx="0.00082607" ixy="0.00015781" ixz="3.2603E-06" iyy="0.0016472" iyz="-1.1473E-06" izz="0.0022106" />
    </inertial>
    <visual>
      <origin xyz="0.0636 0 0.0128" rpy="0 0 0" />
      <geometry>
        <box size="0.17 0.045 0.026" />
      </geometry>
      <material name="forma_link_2">
        <color rgba="0.55 0.75 0.95 1" />
      </material>
    </visual>
  </link>
  <joint name="J2" type="continuous">
    <origin xyz="0.2 0 0.034" rpy="0 0 0.010482" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit effort="100.0" velocity="10.0" />
    <dynamics damping="1.0" friction="1.0" />
  </joint>
  <link name="link_3">
    <inertial>
      <origin xyz="0.00088875 0 -0.079824" rpy="0 0 0" />
      <mass value="0.15047" />
      <inertia ixx="0.00031185" ixy="-3.3248E-08" ixz="1.37E-05" iyy="0.00031502" iyz="1.4361E-07" izz="2.885E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 -0.08" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.01" length="0.16" />
      </geometry>
      <material name="forma_link_3">
        <color rgba="0.95 0.95 0.95 1" />
      </material>
    </visual>
  </link>
  <joint name="J3" type="prismatic">
    <origin xyz="0.12728 0 0.025709" rpy="-3.1416 0 0" />
    <parent link="link_2" />
    <child link="link_3" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.1" effort="1000" velocity="10.0" />
    <dynamics damping="1.0" friction="5.0" />
  </joint>
  <gazebo reference="link_1">
    <gravity>0</gravity>
  </gazebo>
  <gazebo reference="link_2">
    <gravity>0</gravity>
  </gazebo>
  <gazebo reference="link_3">
