      <d_gain>6.0</d_gain>
      <i_max>20.0</i_max>
      <i_min>-20.0</i_min>
      <cmd_max>60.0</cmd_max>
      <cmd_min>-60.0</cmd_min>
    </plugin>
  </gazebo>
