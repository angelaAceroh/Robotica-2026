# ==============================================================================
# .gitignore — Ensamblador 2 (SCARA RRP)
# ==============================================================================

# Python y compilados
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ROS 2 y Colcon
build/
install/
log/
COLCON_IGNORE

# MATLAB y Simulink temporales / caché
slprj/
*.slxc
*.autosave
*.asv

# Metadatos de sistema operativo
.DS_Store
Thumbs.db
*Zone.Identifier*

# Logs de depuración
*.log
*.tlog
